# URL de la API (sin barra final). No va ningún secreto aquí: las variables
# VITE_* quedan incrustadas en el JavaScript que recibe el navegador.
#
# Desarrollo (npm run dev): destino del proxy de /api. Por defecto
#   http://localhost:8000.
# Producción (npm run build): URL pública de la API, fijada al compilar.
#   Vacía = la API se sirve en el mismo dominio que el frontend.
VITE_API_URL=http://localhost:8000
