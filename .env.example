# Copie este archivo a .env (ignorado por git) y complete los valores.
# Aquí NO van secretos reales.
#
# La base de datos es PostgreSQL + PostGIS en Docker (contenedor db), tanto en
# el servidor como en desarrollo.

# -- Base de datos (obligatorias) --------------------------------------------
# Compose y dev.ps1 no arrancan si faltan. Use contraseñas largas y aleatorias,
# solo con letras y números (van dentro de una URL), p. ej.:
#   openssl rand -hex 24
#   PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_})
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Nombre de la base del contenedor (opcional)
# POSTGRES_DB=severidad_vial

# -- Despliegue (docker compose up -d --build) -------------------------------
# Puerto del host donde nginx sirve la app (opcional, por defecto 8080)
# WEB_PORT=8080

# -- Desarrollo local (dev.ps1, uvicorn, pytest) -----------------------------
# Puerto de 127.0.0.1 donde docker-compose.dev.yml publica la base
# (opcional, por defecto 5433 para no chocar con un PostgreSQL local en 5432).
# DB_PUERTO_LOCAL=5433

# DB_URL de la API fuera de Docker: rol de solo lectura app_lectura contra la
# base publicada en 127.0.0.1. dev.ps1 la arma sola; hace falta aquí para
# ejecutar uvicorn a mano o las pruebas de integración (pytest -m integration).
DB_URL=postgresql+psycopg2://app_lectura:<APP_DB_PASSWORD>@127.0.0.1:5433/severidad_vial

# Orígenes CORS de la API de desarrollo. Con el proxy de Vite (npm run dev) no
# hace falta; solo si el navegador llama a la API desde otro origen.
# CORS_ORIGINS=http://localhost:5173
