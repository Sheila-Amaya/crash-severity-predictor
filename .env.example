# Copie este archivo a .env (ignorado por git) y complete los valores.
# Aquí NO van secretos reales.

# -- Desarrollo local (uvicorn + npm run dev) -------------------------------
# Base que usa la API fuera de Docker (p. ej. Supabase).
DB_URL=postgresql://<usuario>:<contraseña>@<host>:5432/<base>
# Orígenes permitidos por CORS, separados por coma (desarrollo: Vite).
CORS_ORIGINS=http://localhost:5173

# -- Docker (docker compose up -d --build) -----------------------------------
# Obligatorias: Compose no arranca si faltan. Use contraseñas largas y
# aleatorias, solo con letras y números (van dentro de una URL), p. ej.:
#   openssl rand -hex 24
#   PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_})
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Nombre de la base del contenedor (opcional)
# POSTGRES_DB=severidad_vial

# Puerto del host donde nginx sirve la app (opcional, por defecto 8080)
# WEB_PORT=8080

# -- Modo Supabase (opcional, en lugar del contenedor db) -------------------
# Cadena de conexión para la API dentro de Docker. Active el modo con:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.supabase.yml   (Linux/macOS)
#   COMPOSE_FILE=docker-compose.yml;docker-compose.supabase.yml   (Windows)
# SUPABASE_DB_URL=postgresql://<usuario>:<contraseña>@<host>:5432/<base>
